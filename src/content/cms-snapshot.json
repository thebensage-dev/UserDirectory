      "updatedAt": "2026-11-27T22:58:00.750Z",
      "createdAt": "2026-11-27T22:58:00.750Z"
    },
    {
      "id": 2,
      "_order": "a1",
      "title": "API",
      "description": "A general-use REST API that the User Directory runs on. Its first feature is a user directory with accent-insensitive search, filters and paging in PostgreSQL, OpenAPI with interactive docs, and writes signed in through authentik and logged per change.",
      "tags": [
        ".NET",
        "Entity Framework Core",
        "PostgreSQL",
        "OpenAPI"
      ],
      "address": "API_URL",
