{
  "name": "user-directory",
  "version": "1.0.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "docker:build": "node scripts/docker-build.mjs",
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "content:snapshot": "cms-snapshot --site user-directory --out src/content/cms-snapshot.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.8",
    "@payloadcms/live-preview-react": "3.94.2",
    "@thebensage-dev/api-client": "^0.2.0",
    "@thebensage-dev/cms-client": "^0.1.0",
    "@thebensage-dev/ui": "^1.4.0",
    "clsx": "^2.1.1",
    "jose": "^6.2.18",
    "lucide-react": "^1.77.0",
    "next": "16.4.6",
    "nuqs": "^2.10.3",
    "openid-client": "^6.9.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.92.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.5",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26"
  },
  "allowScripts": {
    "esbuild": false
  }
}
